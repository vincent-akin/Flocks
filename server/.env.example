NODE_ENV=development
PORT=5000

# MongoDB
# IMPORTANT: this API uses multi-document transactions (org/member creation,
# parish transfers), which MongoDB only supports on a replica set (or
# mongos) - never on a plain standalone instance. MongoDB Atlas's free
# tier is already a replica set, so it works with no extra setup:
#   MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/flocks
# For a local mongod, you must start it with --replSet and initiate it
# once (see server/README.md "Local MongoDB without Docker"), then set:
MONGO_URI=mongodb://127.0.0.1:27017/flocks?replicaSet=rs0

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CLIENT_URL=http://localhost:3000

# Attendance
ATTENDANCE_QR_TTL_SECONDS=300

# SMTP (optional) - if left blank, emails (verification, password reset)
# are logged to the console instead of sent, so the app works out of the
# box in development. Set these for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Flocks <no-reply@yourdomain.com>"
