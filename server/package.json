{
    "name": "flocks-server",
    "version": "1.0.0",
    "type": "module",
    "description": "Flocks Church Management Platform Backend",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "seed": "node scripts/seed.js",
        "build": "echo 'No build step required for Node.js'",
        "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "lint": "eslint src/**/*.js",
        "format": "prettier --write src/**/*.js"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@godaddy/terminus": "^4.12.0",
        "bcrypt": "^5.1.0",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "helmet": "^7.0.0",
        "joi": "^17.9.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.4.1",
        "morgan": "^1.10.0",
        "winston": "^3.10.0"
    },
    "devDependencies": {
        "@eslint/js": "^8.48.0",
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.28.1",
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "prettier": "^3.0.3",
        "supertest": "^6.3.3"
