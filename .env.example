# Used by docker-compose.yml to configure the server and client containers.

# Generate strong random values, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional SMTP - leave blank to log emails to the server console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Flocks <no-reply@yourdomain.com>"
